{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.2",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [{ "matches": ["https://github.com/*"], "js": ["entry.js"], "run_at": "document_idle" }],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/codeyears-16.png",
      "32": "icons/codeyears-32.png",
      "48": "icons/codeyears-48.png",
      "128": "icons/codeyears-128.png"
    }
  },
  "icons": {
    "16": "icons/codeyears-16.png",
    "32": "icons/codeyears-32.png",
    "48": "icons/codeyears-48.png",
    "128": "icons/codeyears-128.png"
  },
  "web_accessible_resources": [{ "resources": ["content.js", "landscape.js", "chunks/*.js", "assets/city/*.png"], "matches": ["https://github.com/*"] }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
